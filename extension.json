{
  "id": "armm-modsets",
  "name": "ARMM Modset Manager",
  "version": "1.1.2",
  "requires": {
    "panel": ">=2.0.0-beta.1 <3.0",
    "php": ">=8.3 <9.0"
  },
  "description": "Native per-server ARMM Modset tab and secure Wings config sync",
  "provider": "ArmmModsets\\ArmmModsetsProvider",
  "autoload": {
    "ArmmModsets\\": "src"
  },
  "icon": "refresh-cw",
  "ui": {
    "entry": "dist/client.js",
    "mode": "native",
    "prefix": "armm",
    "screens": [
      {
        "id": "modsets",
        "area": "server",
        "path": "armm-modsets",
        "permission": [
          "file.update"
        ],
        "nav": {
          "label": "ARMM Modsets",
          "icon": "refresh-cw",
          "order": 80
        }
      }
    ]
  }
}
